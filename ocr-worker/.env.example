# このファイルを .env にコピーして値を入れる（.env は git に入れない）
# 値を書いた行は、同じ名前の環境変数より優先される。値が空の行は無視される。

# GitHub の細かい権限のトークン（Fine-grained PAT）：Vault リポジトリ 1 つだけに、Contents の Read and write
# Vercel の環境変数 GITHUB_TOKEN と同じ種類のもの（同じ値でも別のトークンでもよい）
GITHUB_TOKEN=

# Vault のリポジトリ（既定のままでよければ省略可）
GITHUB_REPO=accees7106-lab/obsidian-vault
VAULT_BRANCH=main
# 写真と処理状態の使い捨てブランチ（Vault の main とは別の名前にする。履歴ごと作り直されるので大事なものは置かない）
INBOX_BRANCH=karte-inbox

# 確認間隔（秒）
POLL_SEC=30
# 任意：モデルを指定する場合（例: opus / sonnet）。空ならサブスクの既定
CLAUDE_MODEL=
# 任意：claude コマンドの場所（既定: Windows は claude.cmd）
CLAUDE_CMD=
